# Copy this file to ".env" and fill in the values. Never commit .env to GitHub.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=n8n

# Generate with:  openssl rand -hex 24
# Keep a backup: if you lose this key, saved credentials in n8n can't be decrypted.
N8N_ENCRYPTION_KEY=paste-generated-key-here

# Local use. Change only if you later expose n8n through a tunnel or server.
WEBHOOK_URL=http://localhost:5678/
